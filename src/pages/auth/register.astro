---
import AuthLayout from '../../layouts/AuthLayout.astro';
---

<AuthLayout title="iQuiz - 注册">
  <h2 class="text-2xl font-bold text-center mb-1">创建账号</h2>
  <p class="text-muted-foreground text-center text-sm mb-6">开始你的高效学习之旅</p>
  
  <div id="error-msg" class="hidden mb-4 p-3 bg-destructive/10 border border-destructive/20 text-destructive rounded-lg text-sm flex items-center gap-2">
    <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 3.75h.008v.008H12v-.008Z" />
    </svg>
    <span id="error-text"></span>
  </div>
  <div id="success-msg" class="hidden mb-4 p-3 bg-success/10 border border-success/20 text-success rounded-lg text-sm flex items-center gap-2">
    <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
    </svg>
    <span id="success-text"></span>
  </div>
  
  <form id="register-form" class="space-y-4">
    <div>
      <label for="displayName" class="block text-sm font-medium text-foreground mb-1.5">用户名</label>
      <input
        type="text"
        id="displayName"
        name="displayName"
        required
        class="input-field"
        placeholder="你的用户名"
      />
    </div>
    
    <div>
      <label for="email" class="block text-sm font-medium text-foreground mb-1.5">邮箱</label>
      <input
        type="email"
        id="email"
        name="email"
        required
        class="input-field"
        placeholder="your@email.com"
      />
    </div>
    
    <div>
      <label for="password" class="block text-sm font-medium text-foreground mb-1.5">密码</label>
      <input
        type="password"
        id="password"
        name="password"
        required
        minlength="6"
        class="input-field"
        placeholder="至少6位密码"
      />
    </div>
    
    <div>
      <label for="confirmPassword" class="block text-sm font-medium text-foreground mb-1.5">确认密码</label>
      <input
        type="password"
        id="confirmPassword"
        name="confirmPassword"
        required
        minlength="6"
        class="input-field"
        placeholder="再次输入密码"
      />
    </div>
    
    <button
      type="submit"
      id="submit-btn"
      class="btn-primary w-full py-2.5 text-base"
    >
      <span id="submit-text">注册</span>
    </button>
  </form>
  
  <div class="mt-6 text-center">
    <p class="text-muted-foreground text-sm">
      已有账号？
      <a href="/auth/login" class="text-primary hover:text-primary-hover font-medium transition-colors">立即登录</a>
    </p>
  </div>
</AuthLayout>

<script>
  import { supabase } from '../../lib/supabase-client';
  
  const form = document.getElementById('register-form') as HTMLFormElement;
  const errorMsg = document.getElementById('error-msg')!;
  const errorText = document.getElementById('error-text')!;
  const successMsg = document.getElementById('success-msg')!;
  const successText = document.getElementById('success-text')!;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const submitText = document.getElementById('submit-text')!;
  
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    errorMsg.classList.add('hidden');
    successMsg.classList.add('hidden');
    
    const displayName = (form.elements.namedItem('displayName') as HTMLInputElement).value;
    const email = (form.elements.namedItem('email') as HTMLInputElement).value;
    const password = (form.elements.namedItem('password') as HTMLInputElement).value;
    const confirmPassword = (form.elements.namedItem('confirmPassword') as HTMLInputElement).value;
    
    if (password !== confirmPassword) {
      errorText.textContent = '两次输入的密码不一致';
      errorMsg.classList.remove('hidden');
      return;
    }
    
    submitBtn.disabled = true;
    submitText.textContent = '注册中...';
    
    try {
      const { data, error } = await supabase.auth.signUp({
        email,
        password,
        options: {
          data: {
            display_name: displayName,
          },
        },
      });
      
      if (error) {
        errorText.textContent = error.message;
        errorMsg.classList.remove('hidden');
        return;
      }
      
      successText.textContent = '注册成功！正在跳转...';
      successMsg.classList.remove('hidden');
      
      setTimeout(() => {
        window.location.href = '/dashboard';
      }, 1000);
    } catch (err) {
      errorText.textContent = '注册失败，请重试';
      errorMsg.classList.remove('hidden');
    } finally {
      submitBtn.disabled = false;
      submitText.textContent = '注册';
    }
  });
</script>
