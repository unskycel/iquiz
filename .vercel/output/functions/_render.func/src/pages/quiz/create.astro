---
import MainLayout from '../../layouts/MainLayout.astro';
import { QuizEditor } from '../../components/react/QuizEditor';
---

<MainLayout title="iQuiz - 创建习题">
  <div class="mb-8">
    <h1 class="text-3xl font-bold text-gray-900">创建新习题</h1>
    <p class="mt-2 text-gray-600">填写习题信息，添加题目</p>
  </div>

  <QuizEditor client:load
    onSave={async (quiz, questions) => {
      // This will be handled by the React component
      console.log('Saving quiz:', quiz, questions);
    }}
    onCancel={() => {
      window.location.href = '/dashboard';
    }}
  />
</MainLayout>