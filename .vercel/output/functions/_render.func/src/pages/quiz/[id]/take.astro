---
import MainLayout from '../../../layouts/MainLayout.astro';
import { QuizRunner } from '../../../components/react/QuizRunner';

const { id } = Astro.params;

// In a real app, we would fetch the quiz data here
// For now, we'll pass the ID and let the React component handle it
---

<MainLayout title="iQuiz - 答题">
  <QuizRunner client:load
    quizId={id}
    onComplete={(attempt, answers) => {
      window.location.href = `/quiz/attempts/${attempt.id}`;
    }}
    onCancel={() => {
      window.location.href = '/dashboard';
    }}
  />
</MainLayout>