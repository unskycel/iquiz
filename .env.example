# Supabase 配置
# 从 Supabase 控制台获取这些值
#
# SUPABASE_URL 和 SUPABASE_ANON_KEY 同时用于服务端和客户端
# 通过 astro.config.mjs 的 vite.define 暴露给浏览器端代码
# SUPABASE_SERVICE_ROLE_KEY 仅用于服务端，不会暴露给前端

SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
